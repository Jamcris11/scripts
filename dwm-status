MUTE=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $3}')
VOLPER=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2'} | tr -d . | sed -e 's/^[[0]]*//g')

if [ "$MUTE" = "[MUTED]" ] ; then
	VOL=""
elif [ "$VOLPER" -eq 0 ] ; then
	VOL=" $VOLPER%"
elif [ "$VOLPER" -lt 50 ] ; then
	VOL=" $VOLPER%"
elif [ "$VOLPER" -lt 90 ] ; then
	VOL=" $VOLPER%"
else
	VOL="!$VOLPER%"
fi

HDD=$(df -h | grep /dev/nvme0n1p3 | awk '{print $4}')
RAM=$(free -h | grep Mem: | awk '{ print $3 }')
TIME=$(date '+%I:%M %p')
DATE=$(date '+%b %e')

dwm -s " $VOL | $HDD | $RAM | $DATE | $TIME "
